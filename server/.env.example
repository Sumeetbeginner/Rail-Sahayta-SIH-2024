# Node.js Server Configuration

# Server Port
PORT=3001

# MongoDB Connection
MONGODB_URL=your_mongodb_connection_string_here

# API URLs for External Services
ML_SERVER_URL=http://localhost:9898
LLM_SERVER_URL=http://localhost:9898

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Production URLs (uncomment for deployment)
# ML_SERVER_URL=https://your-ml-server.onrender.com
# LLM_SERVER_URL=https://rail-sahayta-final-2.onrender.com
# CLIENT_URL=https://railsahayta.neuramaps.in

# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_here_change_in_production

# Environment
NODE_ENV=development
